  Serial.print("อัลตราโซนิก1:"); Serial.print(dist1);
  Serial.print(" อัลตราโซนิก2:"); Serial.print(dist2);
  Serial.print(" อัลตราโซนิก3:"); Serial.print(dist3);
  Serial.print(" อัลตราโซนิก4:"); Serial.print(dist4);
  Serial.print(" ทั่วไป:"); Serial.print(ir5Count);
  Serial.print(" กระดาษ:"); Serial.print(ir6Count);
  Serial.print(" กระป๋อง:"); Serial.print(ir7Count);
  Serial.print(" พลาสติก:"); Serial.println(ir8Count);

  bool close1 = (dist1 > 0 && dist1 <= thresholdCm);
  bool close2 = (dist2 > 0 && dist2 <= thresholdCm);
  bool close3 = (dist3 > 0 && dist3 <= thresholdCm);
  bool close4 = (dist4 > 0 && dist4 <= thresholdCm);
  bool tooClose = close1 || close2 || close3 || close4;

  // ===== บัซเซอร์ทำงานทันที ไม่รอเน็ตเลย =====
   // ===== บัซเซอร์: ดัง 3 วิ -> เงียบ 3 นาที -> วนไปเรื่อยๆ ตราบที่ยังมีถังเต็ม =====
  unsigned long now = millis();

  if (tooClose) {
    if (!wasTooClose) {
      // เพิ่งเต็ม -> เริ่มดังทันที
      softBeep();
      buzzerOn = true;
      buzzerLastChange = now;
    } else if (buzzerOn && now - buzzerLastChange >= BEEP_ON_MS) {
      // ดังครบ 3 วิ -> ดับ
      softStop();
      buzzerOn = false;
      buzzerLastChange = now;
    } else if (!buzzerOn && now - buzzerLastChange >= BEEP_OFF_MS) {
      // เงียบครบ 3 นาที -> ดังอีกรอบ
      softBeep();
      buzzerOn = true;
      buzzerLastChange = now;
    }
  } else if (wasTooClose) {
    // ถังไม่เต็มแล้ว -> หยุดทันที
    if (buzzerOn) softStop();
    buzzerOn = false;
  }
  wasTooClose = tooClose;

  // ===== แค่ "ยัดคิว" ไม่ได้ส่งจริงตรงนี้ ไม่บล็อก loop() แน่นอน =====
  // และรีเซ็ตตัวนับ IR ของถังนั้นๆ ทันทีที่เพิ่งเปลี่ยนเป็น "เต็ม" (ตัดรอบนับใหม่)
  if (close1 && !alertSent1) { queueTelegramAlert(binNames[0]); alertSent1 = true; ir5Count = 0; preferences.putULong("ir5Count", 0); }
  if (close2 && !alertSent2) { queueTelegramAlert(binNames[1]); alertSent2 = true; ir6Count = 0; preferences.putULong("ir6Count", 0); }
  if (close3 && !alertSent3) { queueTelegramAlert(binNames[2]); alertSent3 = true; ir7Count = 0; preferences.putULong("ir7Count", 0); }
  if (close4 && !alertSent4) { queueTelegramAlert(binNames[3]); alertSent4 = true; ir8Count = 0; preferences.putULong("ir8Count", 0); }

  if (!close1) alertSent1 = false;
  if (!close2) alertSent2 = false;
  if (!close3) alertSent3 = false;
  if (!close4) alertSent4 = false;

  // ===== เปลี่ยนการอัปเดตตัวนับ ให้เพิ่มตัวนับตลอดกาลด้วย =====
  if (ir5Detected && !wasIr5Detected) { 
    ir5Count++; preferences.putULong("ir5Count", ir5Count); 
    life_ir5++; preferences.putULong("life_ir5", life_ir5); 
  }
  wasIr5Detected = ir5Detected;

  if (ir6Detected && !wasIr6Detected) { 
    ir6Count++; preferences.putULong("ir6Count", ir6Count); 
    life_ir6++; preferences.putULong("life_ir6", life_ir6); 
  }
  wasIr6Detected = ir6Detected;

  if (ir7Detected && !wasIr7Detected) { 
    ir7Count++; preferences.putULong("ir7Count", ir7Count); 
    life_ir7++; preferences.putULong("life_ir7", life_ir7); 
  }
  wasIr7Detected = ir7Detected;

  if (ir8Detected && !wasIr8Detected) { 
    ir8Count++; preferences.putULong("ir8Count", ir8Count); 
    life_ir8++; preferences.putULong("life_ir8", life_ir8); 
  }
  wasIr8Detected = ir8Detected;

  delay(100);
}
