float readDistanceCm(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return -1;
  return duration * 0.0343 / 2;
}

void softBeep() {
  ledcWriteTone(buzzerPin, ALARM_TONE);
  for (int duty = 0; duty <= maxVolume; duty += 5) {
    ledcWrite(buzzerPin, duty);
    delayMicroseconds(500);
  }
}

void softStop() {
  for (int duty = maxVolume; duty >= 0; duty -= 5) {
    ledcWrite(buzzerPin, duty);
    delayMicroseconds(500);
  }
  ledcWriteTone(buzzerPin, 0);
}

// ===== เพิ่มเฉพาะ: เข้ารหัสข้อมูลสำหรับ POST =====
String telegramUrlEncode(const String &value) {
  String encoded = "";
  const char *hex = "0123456789ABCDEF";

  for (size_t i = 0; i < value.length(); i++) {
    uint8_t c = (uint8_t)value.charAt(i);

    if ((c >= 'a' && c <= 'z') ||
        (c >= 'A' && c <= 'Z') ||
        (c >= '0' && c <= '9') ||
        c == '-' || c == '_' || c == '.' || c == '~') {
      encoded += (char)c;
    } else {
      encoded += '%';
      encoded += hex[(c >> 4) & 0x0F];
      encoded += hex[c & 0x0F];
    }
  }
  return encoded;
}

// ===== เพิ่มเฉพาะ: บันทึกประวัติหลังจาก Telegram เดิมส่งเสร็จ =====
void saveTelegramHistory(const char* combinedBinNames, int binCount) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[TelegramHistory] WiFi ไม่เชื่อมต่อ");
    return;
  }

  if (time(nullptr) < 1700000000) {
    syncClockForTLS();
    if (time(nullptr) < 1700000000) {
      Serial.println("[TelegramHistory] TLS clock unavailable");
      return;
    }
  }
  WiFiClientSecure logClient;
  logClient.setCACert(ISRG_ROOT_X1); // validate server certificate, do not use setInsecure()
  HTTPClient http;

  if (!http.begin(logClient, telegramLogUrl)) {
    Serial.println("[TelegramHistory] เปิด telegram_log.php ไม่สำเร็จ");
    return;
  }

  String logMessage;
  if (binCount > 1) {
    logMessage = "ถังต่อไปนี้ใกล้เต็มพร้อมกัน: " + String(combinedBinNames) + " กรุณาไปเก็บขยะ";
  } else {
    logMessage = "ถัง " + String(combinedBinNames) + " ใกล้เต็มแล้ว! กรุณาไปเก็บขยะ";
  }

  http.setTimeout(5000);
  http.addHeader("Content-Type", "application/x-www-form-urlencoded");

  String postData =
      "api_key=" + telegramUrlEncode(String(telegramLogApiKey)) +
      "&bin_name=" + telegramUrlEncode(String(combinedBinNames)) +
      "&message=" + telegramUrlEncode(logMessage) +
      "&status=" + telegramUrlEncode("ส่งสำเร็จ");

  Serial.println("[TelegramHistory] กำลังบันทึกประวัติ...");

  int httpCode = http.POST(postData);

  if (httpCode > 0) {
    String response = http.getString();
    Serial.printf("[TelegramHistory] HTTP %d: %s\n", httpCode, response.c_str());
  } else {
    Serial.printf("[TelegramHistory] POST ไม่สำเร็จ: %s\n", http.errorToString(httpCode).c_str());
  }

  http.end();
}

