  Serial.println("[TelegramHistory] เริ่มบันทึกประวัติ...");
  saveTelegramHistory(combinedBinNames, binCount);

  if (!telegramClient.connect("api.telegram.org", 443, 5000)) {
    Serial.println("[TelegramTask] เชื่อมต่อไม่ได้ (timeout) ข้ามรอบนี้ไป");
    return;
  }

  String message;
  if (binCount > 1) {
    message = "ถังต่อไปนี้ใกล้เต็มพร้อมกัน: " + String(combinedBinNames) + " กรุณาไปเก็บขยะ";
  } else {
    message = "ถัง " + String(combinedBinNames) + " ใกล้เต็มแล้ว! กรุณาไปเก็บขยะ";
  }
  message.replace(" ", "%20");

  String url = "/bot" + String(botToken) + "/sendMessage?chat_id=" + String(chatId) + "&text=" + message;

  telegramClient.print(String("GET ") + url + " HTTP/1.1\r\n" +
               "Host: api.telegram.org\r\n" +
               "Connection: close\r\n\r\n");

  unsigned long timeout = millis();
  while (telegramClient.connected() && millis() - timeout < 5000) {
    if (telegramClient.available()) {
      telegramClient.read();       // อ่านทิ้งเพื่อเคลียร์บัฟเฟอร์
      timeout = millis();
    }
    delay(10);                     // สำคัญ: คืน CPU ให้ระบบ
  }
  telegramClient.stop();

  // ===== Telegram เดิมจบตรงนี้ ไม่มีการเปลี่ยนวิธีส่ง =====
  Serial.printf("[TelegramTask] ส่งแจ้งเตือนสำเร็จ: %s\n", combinedBinNames);
}

// ===== Task ที่ทำงานอยู่บน Core 0 ตลอดเวลา รอรับคิวจากลูปหลัก =====
// รวบรวมรายการที่เข้าคิวใกล้ๆ กัน (ภายใน 1.5 วินาที) แล้วส่งเป็นข้อความเดียว
void telegramTask(void *parameter) {
  char binName[32];
  for (;;) {
    // รอรับชื่อถังตัวแรกแบบไม่จำกัดเวลา (task ว่างก็แค่รอเฉยๆ ไม่กินซีพียู)
    if (xQueueReceive(telegramQueue, &binName, portMAX_DELAY) == pdTRUE) {
      String combined = String(binName);
      int count = 1;

      // เปิดหน้าต่างรอ 1.5 วินาที เก็บรายการอื่นที่เข้ามาใกล้ๆ กันเข้าด้วยกัน
      unsigned long windowStart = millis();
      char nextBin[32];
      while (millis() - windowStart < 1500) {
        if (xQueueReceive(telegramQueue, &nextBin, pdMS_TO_TICKS(200)) == pdTRUE) {
          combined += ", " + String(nextBin);
          count++;
        }
      }

      sendTelegramAlertBlocking(combined.c_str(), count);
    }
  }
}

// ===== เรียกจากลูปหลัก: แค่ยัดชื่อถังเข้าคิว ไม่บล็อกเลยแม้แต่นิดเดียว =====
void queueTelegramAlert(const char* binName) {
  char buffer[32];
  strncpy(buffer, binName, sizeof(buffer));
  // ส่งเข้าคิวแบบไม่รอ (timeout = 0) ถ้าคิวเต็มก็แค่ข้ามไป ไม่ค้าง
  xQueueSend(telegramQueue, &buffer, 0);
}

